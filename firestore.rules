rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role']) &&
             data.keys().hasOnly(['uid', 'name', 'email', 'role', 'organization', 'photoURL', 'createdAt', 'lastLogin']) &&
             data.uid is string && data.uid == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             data.role in ['SOC Analyst', 'Lead Engineer', 'Security Officer', 'Red Team Architect'] &&
             (!('organization' in data) || (data.organization is string && data.organization.size() <= 120)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('createdAt' in data) || data.createdAt is string) &&
             (!('lastLogin' in data) || data.lastLogin is string);
    }

    function isValidTopology(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'nodes', 'edges', 'createdAt']) &&
             data.keys().hasOnly(['id', 'userId', 'name', 'description', 'version', 'createdAt', 'updatedAt', 'nodes', 'edges', 'metadata']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             (!('version' in data) || (data.version is string && data.version.size() <= 32)) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
             data.nodes is list && data.nodes.size() <= 200 &&
             data.edges is list && data.edges.size() <= 500 &&
             (!('metadata' in data) || data.metadata is map);
    }

    // Operator Users Collection
    match /users/{userId} {
      // Only the authenticated operator can read their own profile
      allow get: if isOwner(userId) && isValidId(userId);
      // Disallow list queries across all users for zero-trust privacy
      allow list: if false;

      // Operator can create their own profile matching their Auth UID
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data);

      // Operator can update their own profile fields
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data);

      // Disallow client deletion of audit user records
      allow delete: if false;

      // Topologies authored by this operator
      match /topologies/{topologyId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(topologyId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(topologyId) && isValidTopology(request.resource.data);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(topologyId) && isValidTopology(request.resource.data) &&
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(topologyId);
      }
    }
  }
}
